NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://trassa:trassa@localhost:5432/trassa
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
APP_URL=http://localhost:3000
MAX_UPLOAD_MB=25
DB_POOL_MAX=10

# E-Mail / SMTP (für Verifizierung und Passwort-Reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Bootstrap administrator (set both in production, then redeploy)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Dokumentenspeicher: local für Entwicklung, s3 für Produktion
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=
S3_PREFIX=documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=AES256
